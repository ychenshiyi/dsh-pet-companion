# ── 素材处理链中间产物（跑 scripts/*.py 可再生，不入仓库） ──
step01/
step02/
step03/
step04/

# ── 素材源（托管在 GitHub Releases assets-videos，不入仓库） ──
video/*.mp4

# ── PR 手工抠像工作数据（本地工作数据，同 step 中间产物，不入库） ──
#   pr/      PR 导出的透明 .mov（路线 B 的输入）
#   prproj/  PR 工程目录（.prproj + 遮罩缓存 + 自动保存，约 2GB）
pr/
prproj/

# ── 本地工具（机器相关，不入仓库） ──
.tools/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── Node ──
node_modules/
.npm-cache/
.npm-tmp-cache/
npm-debug.log*
*.tgz

# ── 临时/备份目录 ──
temp/

# ── dsh-pet 构建产物（全部由 src/ 构建生成，不入仓库；克隆后先 npm run prepare:webm）──
#   lib/                      tsdown bundle（lib/index.js、lib/client.js）+ tsc 声明（lib/types/*.d.ts，npm run types）
#   runtime/electron-helper/shared-core.js  桌面共享纯逻辑（scripts/build-desktop-core.mjs 产出，window.PetShared）
# （lib/types 曾是手写声明才保留跟踪；自 gen-types.mjs 起为生成产物，与 lib/*.js 同等对待）
dsh-pet/lib/
dsh-pet/runtime/electron-helper/shared-core.js

# ── dsh-pet 桌宠应用打包产物（electron-builder 输出，`node scripts/dist.mjs` 可重生）──
dsh-pet/dist-app/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 本地运行截图（含真实对话、宠物名、桌面，不得入库）──
#   要公开截图，先脱敏成独立文件并评审，再 git add -f
assets/screenshots/companion/
*.local.png

# ══════════════════════════════════════════════════════════════════
# 语音栈（voice/）：只入库源码与脚本，运行时产物一律本地生成
#   重建：scripts\bootstrap.ps1（下载模型/二进制 + 建 venv + 校验）
# ══════════════════════════════════════════════════════════════════

# 模型（约 400MB，走 Releases 或 bootstrap 下载）
voice/models/

# Python 虚拟环境（本机 460MB）
voice/.venv/
voice/.venv*/

# LiveKit 服务端二进制（约 55MB，官方 Windows 包）
voice/livekit_*_windows_amd64/

# 服务端配置：含 API key/secret，由应用或 bootstrap 生成
voice/livekit.yaml

# 运行日志与 PID
voice/logs/

# 联调页依赖与产物
voice/dev/node_modules/
voice/dev/test/artifacts/

# Python / pytest / ruff 缓存
voice/__pycache__/
voice/**/__pycache__/
voice/**/*.py[cod]
voice/.pytest_cache/
voice/.ruff_cache/

# 本地密钥（复制 .env.example 生成）
voice/agent/.env
