# 复制为 agent/.env 后按需修改（不提交）
# DeepSeek：留空时会自动复用 ~/.dsh/.credentials.yaml 里的 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LiveKit（不写时自动从 ../livekit.yaml 读 key/secret）
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 音色 / 语速
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%

# 识别语言（zh / en / ja / ko / yue，留空为自动）
STT_LANGUAGE=zh

# 宠物名字（会进人设）
PET_NAME=小鱼
